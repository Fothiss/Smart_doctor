          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "title": "History",
            "description": "Лента диалога: влияет только на поисковый запрос"
          }
        },
        "type": "object",
        "title": "ChatAskRequest",
        "description": "Вопрос врача по выбранным клинрекам."
      },
