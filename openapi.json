            },
            "type": "array",
            "title": "Searched Guidelines"
          }
        },
        "type": "object",
        "required": [
          "status",
          "search"
        ],
        "title": "ChatAnswer",
        "description": "Ответ чата: либо текст со ссылками, либо отказ «не найдено»."
      },
      "ChatAskRequest": {
        "properties": {
          "guideline_ids": {
