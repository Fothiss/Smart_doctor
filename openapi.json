{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart Doctor API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Проверка живости сервиса",
        "description": "Liveness-проба для Docker Compose.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/guidelines": {
      "post": {
        "tags": [
          "guidelines"
        ],
        "summary": "Загрузить PDF клинических рекомендаций",
        "description": "Принять PDF, сохранить в хранилище и вернуть метаданные клинрека.\n\nИндексация запускается после ответа: разбор PDF и эмбеддинги занимают минуты, и\nдержать на них HTTP-запрос нельзя.\n\nПоле ``icd_codes`` объявлено необязательным на уровне FastAPI только ради кода\nответа: отсутствие кодов — это `400` с причиной, а не автоматический `422` от\nвалидации параметров.",
        "operationId": "upload_guideline_api_guidelines_post",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_guideline_api_guidelines_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Guideline"
                }
              }
            }
          },
          "400": {
            "description": "Файл пустой или не PDF, либо нет ни одного кода МКБ"
          },
          "409": {
            "description": "PDF с таким содержимым уже загружен"
          },
          "413": {
            "description": "Файл превышает допустимый размер"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "guidelines"
        ],
        "summary": "Список клинреков",
        "description": "Вернуть клинреки для экрана Library, свежие загрузки первыми.",
        "operationId": "list_guidelines_api_guidelines_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/GuidelineStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Фильтр по состоянию",
              "title": "Status"
            },
            "description": "Фильтр по состоянию"
          },
          {
            "name": "icd",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Фильтр по коду МКБ-10, например I10",
              "title": "Icd"
            },
            "description": "Фильтр по коду МКБ-10, например I10"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Размер страницы",
              "default": 50,
              "title": "Limit"
            },
            "description": "Размер страницы"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Смещение",
              "default": 0,
              "title": "Offset"
            },
            "description": "Смещение"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Guideline"
                  },
                  "title": "Response List Guidelines Api Guidelines Get"
                }
              }
            }
          },
          "422": {
            "description": "Некорректные query-параметры или код МКБ вне формата"
          }
        }
      }
    },
    "/api/guidelines/{guideline_id}": {
      "get": {
        "tags": [
          "guidelines"
        ],
        "summary": "Метаданные клинрека",
        "description": "Вернуть метаданные и статус индексации одного клинрека.",
        "operationId": "get_guideline_api_guidelines__guideline_id__get",
        "parameters": [
          {
            "name": "guideline_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Идентификатор клинрека",
              "title": "Guideline Id"
            },
            "description": "Идентификатор клинрека"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Guideline"
                }
              }
            }
          },
          "404": {
            "description": "Клинрек не найден"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "guidelines"
        ],
        "summary": "Удалить клинрек",
        "description": "Удалить клинрек вместе с оригиналом PDF и его фрагментами.\n\nОбработчик синхронный: удаление чанков в Qdrant блокирующее, и FastAPI выполнит его\nв рабочем потоке, не останавливая цикл событий.",
        "operationId": "delete_guideline_api_guidelines__guideline_id__delete",
        "parameters": [
          {
            "name": "guideline_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Идентификатор клинрека",
              "title": "Guideline Id"
            },
            "description": "Идентификатор клинрека"
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Клинрек не найден"
          },
          "409": {
            "description": "По клинреку идёт индексация"
          },
          "503": {
            "description": "Векторное хранилище недоступно"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/guidelines/{guideline_id}/file": {
      "get": {
        "tags": [
          "guidelines"
        ],
        "summary": "Оригинальный PDF клинрека",
        "description": "Отдать PDF для PDF.js; Range обрабатывает ``FileResponse``.",
        "operationId": "get_guideline_file_api_guidelines__guideline_id__file_get",
        "parameters": [
          {
            "name": "guideline_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Идентификатор клинрека",
              "title": "Guideline Id"
            },
            "description": "Идентификатор клинрека"
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Версия документа; по умолчанию последняя",
              "title": "Version"
            },
            "description": "Версия документа; по умолчанию последняя"
          }
        ],
        "responses": {
          "200": {
            "description": "PDF-поток",
            "content": {
              "application/pdf": {}
            }
          },
          "404": {
            "description": "Клинрек или указанная версия не найдены"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/guidelines/{guideline_id}/index": {
      "post": {
        "tags": [
          "guidelines"
        ],
        "summary": "Запустить индексацию клинрека",
        "description": "Поставить клинрек в обработку и запустить индексацию в фоне.\n\nПовтор нужен после отказа: без него клинрек в ``failed`` остаётся необработанным\nнавсегда, и его фрагменты нельзя процитировать.",
        "operationId": "index_guideline_api_guidelines__guideline_id__index_post",
        "parameters": [
          {
            "name": "guideline_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Идентификатор клинрека",
              "title": "Guideline Id"
            },
            "description": "Идентификатор клинрека"
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Guideline"
                }
              }
            }
          },
          "404": {
            "description": "Клинрек не найден"
          },
          "409": {
            "description": "Индексация этого клинрека уже идёт"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chunks/{chunk_id}": {
      "get": {
        "tags": [
          "chunks"
        ],
        "summary": "Фрагмент клинрека по идентификатору",
        "description": "Вернуть текст цитаты и прямоугольники её подсветки в оригинале.\n\nОбработчик объявлен синхронным: чтение из векторного хранилища блокирующее, и\nFastAPI выполняет его в рабочем потоке, не останавливая цикл событий.",
        "operationId": "get_chunk_api_chunks__chunk_id__get",
        "parameters": [
          {
            "name": "chunk_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Идентификатор фрагмента из вердикта",
              "title": "Chunk Id"
            },
            "description": "Идентификатор фрагмента из вердикта"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chunk"
                }
              }
            }
          },
          "404": {
            "description": "Фрагмент не найден"
          },
          "503": {
            "description": "Векторное хранилище недоступно"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/protocols/validate": {
      "post": {
        "tags": [
          "protocols"
        ],
        "summary": "Проверить черновик протокола",
        "description": "Проверить форму, подтвердить клинрек и вернуть атомарные пункты.\n\nНичего не сохраняет: идентификатора протокола в ответе нет, черновик живёт только в\nинтерфейсе. Это первый шаг проверки — сама проверка на соответствие клинреку появится\nследующим изменением.\n\nОбработчик объявлен синхронным: чтение метаданных клинрека блокирующее, и FastAPI\nвыполнит его в рабочем потоке.",
        "operationId": "validate_protocol_api_protocols_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProtocolDraftRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtocolDraftResponse"
                }
              }
            }
          },
          "400": {
            "description": "Форма не прошла проверку; в причине названо поле"
          },
          "404": {
            "description": "Клинрек или указанная версия не найдены"
          },
          "409": {
            "description": "Клинрек не готов к проверке"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/ask": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Ответить на вопрос по выбранным клинрекам",
        "description": "Ответить по фрагментам выбранных клинреков.\n\nОбработчик асинхронный: поиск уходит в рабочий поток внутри сервиса, а вызов модели\nждёт сеть, не занимая цикл событий.",
        "operationId": "ask_api_chat_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatAskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatAnswer"
                }
              }
            }
          },
          "400": {
            "description": "Пустой вопрос, нет документов или их слишком много"
          },
          "404": {
            "description": "Клинрек не найден"
          },
          "409": {
            "description": "Клинрек не готов отвечать на вопросы"
          },
          "502": {
            "description": "LLM недоступна или отказала"
          },
          "503": {
            "description": "Векторное хранилище недоступно"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_guideline_api_guidelines_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "PDF клинических рекомендаций"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "description": "Название клинрека"
          },
          "icd_codes": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Icd Codes",
            "description": "Коды МКБ-10; хотя бы один обязателен"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_guideline_api_guidelines_post"
      },
      "ChatAnswer": {
