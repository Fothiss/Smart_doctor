# Скопировать в .env и заполнить

# --- PostgreSQL ---
POSTGRES_USER=smart_doctor
POSTGRES_PASSWORD=change_me
POSTGRES_DB=smart_doctor
POSTGRES_PORT=5432

# --- Порты на хосте ---
BACKEND_PORT=8000
FRONTEND_PORT=80

# --- LLM (gigachat | deepseek), единый интерфейс в app/clients/ ---
LLM_PROVIDER=gigachat
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
DEEPSEEK_API_KEY=

# --- Embeddings (локально, Sentence-Transformers, CPU) ---
EMBEDDING_MODEL=sergeyzh/BERTA
