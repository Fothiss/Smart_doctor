# Скопировать в .env и заполнить
#
# Backend читает файлы по порядку: сначала корневой .env, затем backend/.env
# (побеждает последний). Пути считаются от файла настроек, а не от текущего каталога.

# --- PostgreSQL ---
POSTGRES_USER=smart_doctor
POSTGRES_PASSWORD=change_me
POSTGRES_DB=smart_doctor
POSTGRES_PORT=5432

# --- Порты на хосте ---
BACKEND_PORT=8000
FRONTEND_PORT=80

# --- Backend (локальный запуск: python app/__main__.py из backend/) ---
# В Docker Compose значения DATABASE_URL/QDRANT_URL/STORAGE_DIR/HOST задаёт Dockerfile/compose
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=50
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Без DATABASE_URL приложение стартует: текущие эндпоинты БД не используют,
# а обращение к базе падает с явной ошибкой DatabaseNotConfiguredError
DATABASE_URL=postgresql+psycopg://smart_doctor:change_me@localhost:5432/smart_doctor

# --- Векторное хранилище (Qdrant) ---
# local — встроенное хранилище в каталоге (контейнеры не нужны), server — сервер по QDRANT_URL
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
QDRANT_LOCAL_PATH=storage/qdrant
# База имени коллекции: размерность модели дописывается кодом (guideline_chunks__1024)
QDRANT_COLLECTION=guideline_chunks

# --- Чанкинг (размеры в символах) ---
CHUNK_TARGET_CHARS=800
CHUNK_MIN_CHARS=300
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP_CHARS=150

# --- LLM (gigachat | deepseek), единый интерфейс в app/clients/ ---
LLM_PROVIDER=gigachat
# Ключ авторизации из кабинета Studio: SDK сам получает и продлевает access token
GIGACHAT_TOKEN=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
# Переписывание запроса — задача проще, поэтому модель дешевле
GIGACHAT_REWRITE_MODEL=GigaChat-2
GIGACHAT_BASE_URL=https://api.giga.chat/v1
# function_calling — работает на всех моделях; json_schema — нативное ограничение, пока beta
GIGACHAT_STRUCTURED_METHOD=function_calling
# Локально сертификат НУЦ Минцифры не ставится: для боевого режима включить проверку
# и указать GIGACHAT_CA_BUNDLE_FILE
GIGACHAT_VERIFY_SSL_CERTS=false
GIGACHAT_CA_BUNDLE_FILE=
GIGACHAT_TIMEOUT=60
GIGACHAT_MAX_RETRIES=3
DEEPSEEK_API_KEY=

# --- Чат по клинрекам ---
# Фрагментов в контексте: модели дешевле выкинуть лишнее, чем не заметить нужное
CHAT_TOP_K=8
CHAT_MAX_CONTEXT_CHARS=12000
CHAT_MAX_GUIDELINES=5
CHAT_HISTORY_WINDOW=4
# Порог близости фрагмента: 0 — выключен, значение подбирается по наблюдениям
CHAT_MIN_SCORE=0

# --- Embeddings (локальная модель, Sentence-Transformers, CPU) ---
# Файлы модели кладутся вручную в ML_MODELS_DIR/<папка>: см. backend/ml_models/README.md
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
ML_MODELS_DIR=ml_models
EMBEDDING_MODEL_PATH=Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
EMBEDDING_MAX_SEQ_LENGTH=512
EMBEDDING_BATCH_SIZE=8
# Потоки нужны только при инференсе на CPU; по умолчанию — все ядра минус одно
EMBEDDING_THREADS=7
# auto — видеокарта, если сборка PyTorch её видит; cpu — всегда процессор (контейнер без GPU).
# Замер на GTX 1650: 341 мс на чанк (весь документ ~2.4 мин), на CPU — 3.5 с (25 мин)
EMBEDDING_DEVICE=auto
# Инструкция добавляется только запросам: документы кодируются без неё
EMBEDDING_QUERY_INSTRUCTION=Given a clinical protocol statement, retrieve the clinical guideline fragment that covers it
